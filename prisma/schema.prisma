datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. 新增用户表
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique                       // 邮箱作为登录账号，唯一
  password  String                                 // 存储加密后的哈希密码
  name      String?                                // 昵称
  posts     Post[]                                 // 关联文章：一个用户拥有多篇文章
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 定义数据表：Post
model Post {
  id        Int      @id @default(autoincrement()) // 自增主键 ID
  title     String                                // 字符串标题
  content   String?                               // 可选内容
  published Boolean  @default(false)              // 是否发布，默认 false
  createdAt DateTime @default(now())              // 创建时间，默认当前时间
  updatedAt DateTime @updatedAt                   // 更新时间，更新时自动刷新
  // 关联外键
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}